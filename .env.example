# Kafka
KAFKA_BOOTSTRAP_SERVERS=kafka:9092

# Security
JWT_SECRET=CHANGE_ME_BASE64_SECRET

# CORS and frontend
APP_CORS_ALLOWED_ORIGIN=http://localhost:3000,http://localhost:5173
CHAT_WEBSOCKET_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
FRONTEND_URL=http://localhost:3000

# MongoDB URIs
MONGO_AUTH_URI=mongodb://host.docker.internal:27017/socialmediaauthdb
MONGO_USER_URI=mongodb://host.docker.internal:27017/socialmediauserdb
MONGO_MEDIA_URI=mongodb://host.docker.internal:27017/socialmediamediadb
CHAT_MONGO_URI=mongodb://host.docker.internal:27017/socialmediachatdb
MONGO_NOTIFICATION_URI=mongodb://host.docker.internal:27017/socialmedianotificationdb
MONGO_ADMIN_URI=mongodb://host.docker.internal:27017/socialmediaadmindb
MONGO_GATEWAY_URI=mongodb://host.docker.internal:27017/socialmediaauthdb

# SQL Server
SOCIAL_SQLSERVER_URL=jdbc:sqlserver://host.docker.internal:1433;databaseName=SocialMediaDB;encrypt=true;trustServerCertificate=true
SOCIAL_DB_USERNAME=abc
SOCIAL_DB_PASSWORD=123456

# Mail (auth service)
MAIL_HOST=sandbox.smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=your_mailtrap_username
MAIL_PASSWORD=your_mailtrap_password

# Cloudinary (media service)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Bootstrap admin account (auth service)
BOOTSTRAP_ADMIN_USERNAME=superadmin
BOOTSTRAP_ADMIN_EMAIL=superadmin@gummynetwork.local
BOOTSTRAP_ADMIN_PASSWORD=Admin@123
BOOTSTRAP_ADMIN_FULL_NAME=Super Admin
